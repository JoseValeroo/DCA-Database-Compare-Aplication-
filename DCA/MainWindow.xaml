<Window x:Class="DCA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCA - Comparador de Esquemas"
        Height="600" Width="980"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="Auto"/>
            <!-- Carpeta trabajo -->
            <RowDefinition Height="Auto"/>
            <!-- Conexiones -->
            <RowDefinition Height="Auto"/>
            <!-- Acciones -->
            <RowDefinition Height="*"/>
            <!-- Log -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Comparador de Esquemas (DACPAC) by Jose Valero :3"
                       FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="1) Exporta ORIGEN  2) Exporta DESTINO  3) Compara y genera salidas"
                       Opacity="0.7" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Carpeta de trabajo -->
        <GroupBox Grid.Row="1" Header="Carpeta de trabajo" Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="WorkDirTextBox"
                         IsReadOnly="True"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Text="(se usará la carpeta del .exe si no eliges otra)"/>

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Height="28"
                        Content="Elegir carpeta…"
                        Click="PickWorkDirButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Conexiones -->
        <GroupBox Grid.Row="2" Header="Conexiones" Margin="0,0,0,12">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ORIGEN -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Origen" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="OrigenConnectionStringTextBox"
                             MinHeight="86"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Pega aquí la cadena de conexión de ORIGEN (puede ser multilínea)."
                             Text="Server=SVJC-DES-SQL4\SQL2019&#x0a;Database=ESMIC2&#x0a;Trusted_Connection=True&#x0a;Encrypt=True&#x0a;TrustServerCertificate=True" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom">
                    <Button Name="ExportOrigenButton"
                            Content="Exportar Origen"
                            Height="40"
                            Margin="0,0,0,8"
                            Click="ExportOrigenButton_Click"/>
                    <TextBlock Text="Guarda en /origen"
                               Opacity="0.7"
                               FontSize="12"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- DESTINO -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Destino" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="DestinoConnectionStringTextBox"
                             MinHeight="86"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Pega aquí la cadena de conexión de DESTINO (puede ser multilínea)."
                             Text="Server=SVJC-PRE-SQL4\SQL2019&#x0a;Database=ESMIC2&#x0a;Trusted_Connection=True&#x0a;Encrypt=True&#x0a;TrustServerCertificate=True" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom">
                    <Button Name="ExportDestinoButton"
                            Content="Exportar Destino"
                            Height="40"
                            Margin="0,0,0,8"
                            Click="ExportDestinoButton_Click"/>
                    <TextBlock Text="Guarda en /destino"
                               Opacity="0.7"
                               FontSize="12"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Acciones -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Name="CompararButton"
                    Grid.Column="0"
                    Content="3) Comparar y generar salidas"
                    Height="40"
                    Padding="18,0"
                    Click="CompararButton_Click"/>

            <TextBlock Name="EstadoTextBlock"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Opacity="0.85"/>
        </Grid>

        <!-- Log -->
        <GroupBox Grid.Row="4" Header="Log">
            <TextBox Name="LogTextBox"
                     Margin="8"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </GroupBox>
    </Grid>
</Window>
