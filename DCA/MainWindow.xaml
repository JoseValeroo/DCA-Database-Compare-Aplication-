<Window x:Class="DCA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCA - Comparador de Esquemas"
        Height="640" Width="980"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="*"/>
            <!-- Tabs + contenido -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Comparador de Esquemas (DACPAC) by Jose Valero :3"
                       FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Exporta paquetes (DACPAC + tablas + EP) y compara (online u offline por carpetas)."
                       Opacity="0.7" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- =========================
             TABS
             ========================= -->
        <TabControl Grid.Row="1">
            <!-- =========================================================
                 TAB 1: ONLINE (BBDD -> archivos locales)
                 ========================================================= -->
            <TabItem Header="Exportar desde BBDD">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Carpeta trabajo -->
                        <RowDefinition Height="Auto"/>
                        <!-- Conexiones -->
                        <RowDefinition Height="Auto"/>
                        <!-- Acciones -->
                        <RowDefinition Height="*"/>
                        <!-- Log -->
                    </Grid.RowDefinitions>

                    <!-- Carpeta de trabajo -->
                    <GroupBox Grid.Row="0" Header="Carpeta de trabajo" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="WorkDirTextBox"
                                     IsReadOnly="True"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     Text="(se usará la carpeta del .exe si no eliges otra)"/>

                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Height="28"
                                    Content="Elegir carpeta…"
                                    Click="PickWorkDirButton_Click"/>
                        </Grid>
                    </GroupBox>

                    <!-- Conexiones -->
                    <GroupBox Grid.Row="1" Header="Conexiones" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ORIGEN -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                <TextBlock Text="Origen" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="OrigenConnectionStringTextBox"
                                         MinHeight="86"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="Pega aquí la cadena de conexión de ORIGEN (puede ser multilínea)."
                                         Text="Server=SVJC-DES-SQL4\SQL2019&#x0a;Database=ESMIC2&#x0a;Trusted_Connection=True&#x0a;Encrypt=True&#x0a;TrustServerCertificate=True" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom">
                                <Button Name="ExportOrigenButton"
                                        Content="Exportar Origen"
                                        Height="40"
                                        Margin="0,0,0,8"
                                        Click="ExportOrigenButton_Click"/>
                                <TextBlock Text="Guarda en /origen"
                                           Opacity="0.7"
                                           FontSize="12"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <!-- DESTINO -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Destino" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="DestinoConnectionStringTextBox"
                                         MinHeight="86"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="Pega aquí la cadena de conexión de DESTINO (puede ser multilínea)."
                                         Text="Server=SVJC-PRE-SQL4\SQL2019;Database=ESMIC2;User Id=USUARIO_PRE;Password=CONTRASEÑA_PRE;Encrypt=True;TrustServerCertificate=True;"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom">
                                <Button Name="ExportDestinoButton"
                                        Content="Exportar Destino"
                                        Height="40"
                                        Margin="0,0,0,8"
                                        Click="ExportDestinoButton_Click"/>
                                <TextBlock Text="Guarda en /destino"
                                           Opacity="0.7"
                                           FontSize="12"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Acciones -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Name="CompararButton"
                                Grid.Column="0"
                                Content="3) Comparar y generar salidas"
                                Height="40"
                                Padding="18,0"
                                Click="CompararButton_Click"/>

                        <TextBlock Name="EstadoTextBlock"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Opacity="0.85"/>
                    </Grid>

                    <!-- Log -->
                    <GroupBox Grid.Row="3" Header="Log">
                        <TextBox Name="LogTextBox"
                                 Margin="8"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- =========================================================
                 TAB 2: OFFLINE (carpetas -> comparar)
                 - Solo XAML: los Click handlers los implementas en el .cs
                 ========================================================= -->
            <TabItem Header="Comparar por ficheros (Offline)">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Instrucciones -->
                        <RowDefinition Height="Auto"/>
                        <!-- Selección carpetas -->
                        <RowDefinition Height="Auto"/>
                        <!-- Acciones -->
                        <RowDefinition Height="*"/>
                        <!-- Log (mismo LogTextBox) -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10" CornerRadius="6" Background="#0F000000" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Modo Offline (PRO → USB → PRE)"/>
                            <TextBlock Opacity="0.75" Margin="0,4,0,0"
                                       Text="1) En PRO: Exporta (Origen o Destino) y copia la carpeta generada (origen/destino) al USB. 2) En PRE: Exporta el otro lado. 3) Selecciona ambas carpetas aquí y compara."/>
                        </StackPanel>
                    </Border>

                    <GroupBox Grid.Row="1" Header="Carpetas a comparar" Margin="0,0,0,12">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Carpeta A (p.ej. PRO) -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                                <TextBlock Text="Carpeta A (p.ej. PRO)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="OfflineFolderATextBox"
                                         Height="28"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Carpeta que contiene schema.dacpac, /tablas y extended_properties.sql"/>
                            </StackPanel>
                            <Button Grid.Row="0" Grid.Column="1"
                                    Height="28"
                                    Content="Elegir…"
                                    Click="PickOfflineFolderAButton_Click"/>

                            <!-- Carpeta B (p.ej. PRE) -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,10">
                                <TextBlock Text="Carpeta B (p.ej. PRE)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="OfflineFolderBTextBox"
                                         Height="28"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Carpeta que contiene schema.dacpac, /tablas y extended_properties.sql"/>
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="1"
                                    Height="28"
                                    Content="Elegir…"
                                    Click="PickOfflineFolderBButton_Click"/>

                            <!-- Carpeta salidas -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Carpeta de salida (report)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="OfflineOutFolderTextBox"
                                         Height="28"
                                         VerticalContentAlignment="Center"
                                         Text="(si vacío: usa /salidas de la carpeta de trabajo)"/>
                            </StackPanel>
                            <Button Grid.Row="2" Grid.Column="1"
                                    Height="28"
                                    Content="Elegir…"
                                    Click="PickOfflineOutFolderButton_Click"/>
                        </Grid>
                    </GroupBox>

                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Name="CompararOfflineButton"
                                Grid.Column="0"
                                Content="Comparar carpetas (DDL + EP)"
                                Height="40"
                                Padding="18,0"
                                Click="CompararOfflineButton_Click"/>

                        <TextBlock Name="EstadoOfflineTextBlock"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Opacity="0.85"
                                   Text="Selecciona dos carpetas y compara."/>
                    </Grid>

                    <!-- Reutilizamos el MISMO log (LogTextBox) para no duplicar -->
                    <GroupBox Grid.Row="3" Header="Log">
                        <TextBox Margin="8"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ElementName=LogTextBox, Path=Text}"
                                 />
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
